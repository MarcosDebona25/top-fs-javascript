# Database (role and database are created once with psql; see README)
DATABASE_URL="postgresql://wheres_waldo:wheres_waldo@localhost:5432/wheres_waldo"
# Optional: the API tests use DATABASE_URL with "_test" appended unless this is set
# TEST_DATABASE_URL="postgresql://wheres_waldo:wheres_waldo@localhost:5432/wheres_waldo_test"

# Server
PORT=3000

# Session: generate the secret with
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="replace-with-64-random-bytes-in-hex"
SESSION_MAX_AGE_DAYS=7

# Session cookie: Secure is required; set to false only if a local client refuses Secure cookies over http://localhost
COOKIE_SECURE=true

# CORS: comma-separated list of origins allowed to call the API (the client dev server)
CORS_ORIGINS="http://localhost:5173"

# Game rules (all times in milliseconds)
# A game finished faster than this is considered implausible and is not ranked
MIN_GAME_MS=5000
# Added to the final time for every wrong selection
WRONG_GUESS_PENALTY_MS=1000
# Extra margin around a character's rectangle, as a fraction of the image (0.005 = 0.5%)
HIT_MARGIN=0.005

# Leaderboard live updates (Server-Sent Events): heartbeat so proxies keep the connection open
SSE_HEARTBEAT_MS=25000
