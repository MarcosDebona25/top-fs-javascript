<header>
    <h1>MarkINC</h1>
    <nav aria-label="Navegación principal">
        <ul>
            <% navLinks.forEach((link) => { %>
                <li>
                    <a href="<%= link.href %>"
                       class="<%= currentPath === link.href ? 'active' : '' %>"
                       <%= currentPath === link.href ? 'aria-current="page"' : '' %>>
                        <%= link.label %>
                    </a>
                </li>
            <% }) %>
        </ul>
    </nav>
</header>
