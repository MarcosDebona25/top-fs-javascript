<%- include('partials/header', { title: heading }) %>
<section class="panel">
  <h1><%= heading %></h1>
  <p class="muted"><%= blurb %></p>
  <form method="post" action="<%= action %>" novalidate data-validate="passcode">
    <%- include('partials/field', { name: 'passcode', label: 'Passcode', type: 'password', error: error, autocomplete: 'off' }) %>
    <button type="submit" class="btn btn-primary btn-block" data-submit>Submit</button>
  </form>
</section>
<%- include('partials/footer') %>
