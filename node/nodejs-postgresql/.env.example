# Option 1: single connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/top_users"

# Option 2: individual parts (used when DATABASE_URL is unset)
DB_HOST=localhost
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=top_users
DB_PORT=5432

# app port (defaults to 3000 in app.js)
PORT=3000