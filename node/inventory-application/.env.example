# Copy to `.env` and fill in real values for local development.
# Never commit `.env`.

# Application database (see README for the local cluster setup)
DATABASE_URL=postgresql://inventory_app:change_me@127.0.0.1:5433/axle_supply

# Database used by the automated test suite
TEST_DATABASE_URL=postgresql://inventory_app:change_me@127.0.0.1:5433/axle_supply_test

# Shared administrative password required for protected POST actions
ADMIN_PASSWORD=change_me

# Secret used to sign the anonymous CSRF session cookie
SESSION_SECRET=change_me

# Port for the development server
PORT=3000

# Environment: development | test | production
NODE_ENV=development
