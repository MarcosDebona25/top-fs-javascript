<%- include('../partials/head', { title: 'Edit category' }) %>
<body>
  <%- include('../partials/header') %>
  <main id="main" class="container">
    <%- include('../partials/breadcrumbs', { crumbs: [
      { label: 'Home', href: '/' },
      { label: category.name, href: '/categories/' + category.id },
      { label: 'Edit' }
    ] }) %>

    <section class="panel panel--form">
      <h1>Edit category</h1>
      <p class="panel__intro">Editing a category is protected: enter the administrative password.</p>

      <%- include('../partials/flash') %>
      <%- include('../partials/form-errors', { errors }) %>

      <form method="post" action="/categories/<%= category.id %>/edit" novalidate>
        <%- include('../partials/csrf-input') %>
        <%- include('../partials/field-text', {
          name: 'name', id: 'name', label: 'Name', required: true,
          value: values.name, errors,
          extraAttrs: 'maxlength="80" autocomplete="off"'
        }) %>
        <%- include('../partials/field-textarea', {
          name: 'description', id: 'description', label: 'Description',
          value: values.description, errors, rows: 4,
          extraAttrs: 'maxlength="1000"'
        }) %>
        <%- include('../partials/field-text', {
          name: 'admin_password', id: 'admin_password', label: 'Administrative password',
          type: 'password', required: true, errors,
          hint: 'Required for every protected change.',
          extraAttrs: 'autocomplete="off"'
        }) %>
        <div class="form-actions">
          <button type="submit" class="button button--primary">Save changes</button>
          <a class="button button--ghost" href="/categories/<%= category.id %>">Cancel</a>
        </div>
      </form>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
