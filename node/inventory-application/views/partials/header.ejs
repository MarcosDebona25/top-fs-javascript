<%#
  Site header. The active item is derived from currentPath and
  currentStatus (set in app.js); both are guarded because error pages
  can render before those locals exist.
%>
<%
  const navPath = typeof currentPath === 'string' ? currentPath : '';
  const navStatus = typeof currentStatus === 'string' ? currentStatus : '';
  const isItems = navPath === '/items' || /^\/items\/\d+/.test(navPath);
  const active =
    navPath === '/' ? 'home'
    : navPath === '/items/new' ? 'new-part'
    : navPath === '/categories/new' ? 'new-category'
    : navPath === '/items' && navStatus === 'archived' ? 'archived'
    : isItems ? 'catalog'
    : '';
  const current = (key) => (active === key ? ' aria-current="page"' : '');
%>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Axle Supply, home">
      <svg class="brand__mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="12.5" fill="none" stroke="currentColor" stroke-width="2.4"/>
        <circle cx="16" cy="16" r="4.2" fill="currentColor"/>
        <path d="M16 3.5v6M16 22.5v6M3.5 16h6M22.5 16h6" stroke="currentColor" stroke-width="2.4"/>
      </svg>
      <span class="brand__text">
        <span class="brand__name">Axle Supply</span>
        <span class="brand__sub">Parts inventory</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        <li><a class="site-nav__link" href="/"<%- current('home') %>>Home</a></li>
        <li><a class="site-nav__link" href="/items"<%- current('catalog') %>>Catalog</a></li>
        <li><a class="site-nav__link" href="/items?status=archived"<%- current('archived') %>>Archived</a></li>
      </ul>
      <div class="site-nav__actions">
        <a class="button button--on-ink" href="/categories/new"<%- current('new-category') %>>New category</a>
        <a class="button button--on-ink-solid" href="/items/new"<%- current('new-part') %>>New part</a>
      </div>
    </nav>
  </div>
</header>
