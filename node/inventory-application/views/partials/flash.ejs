<% if (flash) { %>
<div class="flash flash--<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
  <span class="flash__label"><%= flash.type === 'success' ? 'Done' : flash.type === 'error' ? 'Error' : 'Notice' %>:</span>
  <p class="flash__message"><%= flash.message %></p>
</div>
<% } %>
