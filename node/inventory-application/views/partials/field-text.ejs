<%#
  Text input field with label, hint and error.
  Locals: name, id, label, type, value, hint, required, errors, extraAttrs,
          width ('xs' | 'sm' | 'md'), mono (boolean), prefix (e.g. '$')
  Optional locals are guarded because EJS 7 includes do not
  inherit variables that the caller did not pass explicitly.
%>
<%
  const fieldType = typeof type !== 'undefined' ? type : 'text';
  const fieldHint = typeof hint !== 'undefined' ? hint : null;
  const isRequired = typeof required !== 'undefined' ? required : false;
  const fieldAttrs = typeof extraAttrs !== 'undefined' ? extraAttrs : '';
  const fieldValue = typeof value !== 'undefined' ? value : '';
  const fieldWidth = typeof width !== 'undefined' && width ? ' field--' + width : '';
  const isMono = typeof mono !== 'undefined' ? mono : false;
  const fieldPrefix = typeof prefix !== 'undefined' ? prefix : null;
  const fieldError = errors && errors[name] ? errors[name] : null;
  const describedBy = [fieldHint ? id + '-hint' : null, fieldError ? id + '-error' : null].filter(Boolean).join(' ');
%>
<div class="field<%= fieldWidth %><%= fieldError ? ' field--invalid' : '' %>">
  <label for="<%= id %>"><%= label %><% if (isRequired) { %> <span class="field__required" title="Required" aria-hidden="true">*</span><% } %></label>
  <% if (fieldPrefix) { %><div class="input-group"><span class="input-group__prefix" aria-hidden="true"><%= fieldPrefix %></span><% } %>
  <input class="input<%= isMono ? ' mono' : '' %>" type="<%= fieldType %>" id="<%= id %>" name="<%= name %>" value="<%= fieldValue != null ? fieldValue : '' %>" <%- fieldAttrs %><% if (isRequired) { %> aria-required="true"<% } %><% if (fieldError) { %> aria-invalid="true"<% } %><% if (describedBy) { %> aria-describedby="<%= describedBy %>"<% } %>>
  <% if (fieldPrefix) { %></div><% } %>
  <% if (fieldHint) { %><p class="field__hint" id="<%= id %>-hint"><%= fieldHint %></p><% } %>
  <% if (fieldError) { %><p class="field__error" id="<%= id %>-error"><%= fieldError.msg %></p><% } %>
</div>
