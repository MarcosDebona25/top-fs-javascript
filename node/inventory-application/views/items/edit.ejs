<%- include('../partials/head', { title: 'Edit part' }) %>
<body>
  <%- include('../partials/header') %>
  <main id="main" class="container">
    <%- include('../partials/breadcrumbs', { crumbs: [
      { label: 'Home', href: '/' },
      { label: item.name, href: '/items/' + item.id },
      { label: 'Edit' }
    ] }) %>

    <section class="panel panel--form">
      <h1>Edit part</h1>
      <p class="panel__intro">The SKU identifies the part and never changes. Stock is only modified by recording movements.</p>
      <%- include('../partials/required-legend') %>

      <%- include('../partials/flash') %>
      <%- include('../partials/form-errors', { errors }) %>

      <form method="post" action="/items/<%= item.id %>/edit" novalidate>
        <%- include('../partials/csrf-input') %>

        <fieldset class="fieldset">
          <legend>Identification</legend>
          <%- include('../partials/field-select', {
            name: 'category_id', id: 'category_id', label: 'Category', required: true,
            value: values.category_id, errors, width: 'md',
            options: categories.map((category) => ({ value: category.id, label: category.name }))
          }) %>
          <div class="field-row">
            <div class="field">
              <label for="sku">SKU</label>
              <input class="input mono" type="text" id="sku" value="<%= item.sku %>" readonly aria-readonly="true" aria-describedby="sku-hint">
              <p class="field__hint" id="sku-hint">Fixed: the SKU is the part's identity.</p>
            </div>
            <%- include('../partials/field-text', {
              name: 'part_number', id: 'part_number', label: 'Part number',
              value: values.part_number, errors, mono: true,
              hint: 'Optional manufacturer code.',
              extraAttrs: 'maxlength="60" autocomplete="off" spellcheck="false"'
            }) %>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>Commercial</legend>
          <%- include('../partials/field-text', {
            name: 'name', id: 'name', label: 'Part name', required: true,
            value: values.name, errors,
            extraAttrs: 'maxlength="120" autocomplete="off"'
          }) %>
          <div class="field-row">
            <%- include('../partials/field-text', {
              name: 'brand', id: 'brand', label: 'Brand', required: true,
              value: values.brand, errors,
              extraAttrs: 'maxlength="80" autocomplete="off"'
            }) %>
            <%- include('../partials/field-text', {
              name: 'unit_price', id: 'unit_price', label: 'Unit price (USD)', required: true,
              type: 'text', value: values.unit_price, errors, mono: true, prefix: '$', width: 'sm',
              hint: 'Up to 2 decimals, for example 14.99.',
              extraAttrs: 'inputmode="decimal" autocomplete="off"'
            }) %>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>Notes</legend>
          <%- include('../partials/field-textarea', {
            name: 'description', id: 'description', label: 'Description',
            value: values.description, errors, rows: 4,
            hint: 'Optional. Up to 1000 characters.',
            extraAttrs: 'maxlength="1000"'
          }) %>
        </fieldset>

        <%- include('../partials/auth-field', { errors }) %>

        <div class="form-actions">
          <button type="submit" class="button button--primary">Save changes</button>
          <a class="button button--ghost" href="/items/<%= item.id %>">Cancel</a>
        </div>
      </form>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
