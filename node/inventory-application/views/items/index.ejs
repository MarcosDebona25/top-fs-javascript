<%- include('../partials/head', { title: filters.status === 'archived' ? 'Archived parts' : 'Catalog' }) %>
<body>
  <%- include('../partials/header') %>
  <main id="main" class="container">
    <%- include('../partials/breadcrumbs', { crumbs: [{ label: 'Home', href: '/' }, { label: filters.status === 'archived' ? 'Archived parts' : 'Catalog' }] }) %>
    <%- include('../partials/flash') %>

    <section class="page-head page-head--actions">
      <div>
        <h1><%= filters.status === 'archived' ? 'Archived parts' : 'Parts catalog' %></h1>
        <p class="lede"><%= pagination.total %> part<%= pagination.total === 1 ? '' : 's' %> found.</p>
      </div>
      <div class="page-head__actions">
        <a class="button button--primary" href="/items/new">New part</a>
      </div>
    </section>

    <section class="panel panel--filters" aria-label="Search and filters">
      <form method="get" action="/items" class="filters">
        <div class="field">
          <label for="q">Search</label>
          <input class="input" type="search" id="q" name="q" value="<%= filters.q || '' %>" placeholder="Name, SKU or brand" autocomplete="off">
        </div>
        <div class="field">
          <label for="category_id">Category</label>
          <select class="input" id="category_id" name="category_id">
            <option value="">All categories</option>
            <% categories.forEach((category) => { %>
              <option value="<%= category.id %>"<%= String(category.id) === String(filters.categoryId) ? ' selected' : '' %>><%= category.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="availability">Availability</label>
          <select class="input" id="availability" name="availability">
            <option value="all"<%= filters.availability === 'all' ? ' selected' : '' %>>All</option>
            <option value="in_stock"<%= filters.availability === 'in_stock' ? ' selected' : '' %>>In stock</option>
            <option value="out_of_stock"<%= filters.availability === 'out_of_stock' ? ' selected' : '' %>>Out of stock</option>
          </select>
        </div>
        <div class="field">
          <label for="status">Status</label>
          <select class="input" id="status" name="status">
            <option value="active"<%= filters.status === 'active' ? ' selected' : '' %>>Active</option>
            <option value="archived"<%= filters.status === 'archived' ? ' selected' : '' %>>Archived</option>
          </select>
        </div>
        <div class="filters__actions">
          <button type="submit" class="button button--primary">Apply</button>
          <a class="button button--ghost" href="/items">Clear</a>
        </div>
      </form>
    </section>

    <section class="panel" aria-labelledby="results-title">
      <h2 id="results-title" class="visually-hidden"><%= filters.status === 'archived' ? 'Archived parts' : 'Parts' %></h2>
      <% if (!items.length) { %>
        <%- include('../partials/empty-state', {
          title: 'No parts match',
          text: 'Adjust the search or filters, or create a new part.',
          actionHref: '/items/new',
          actionLabel: 'New part'
        }) %>
      <% } else { %>
        <%- include('../partials/item-table', { items }) %>
        <%- include('../partials/pagination', { pagination, hrefFor }) %>
      <% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
