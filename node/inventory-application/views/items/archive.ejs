<%- include('../partials/head', { title: 'Archive part' }) %>
<body>
  <%- include('../partials/header') %>
  <main id="main" class="container">
    <%- include('../partials/breadcrumbs', { crumbs: [
      { label: 'Home', href: '/' },
      { label: item.name, href: '/items/' + item.id },
      { label: 'Archive' }
    ] }) %>

    <div class="form-layout">
      <section class="panel panel--form">
        <h1>Archive part</h1>
        <p class="panel__intro">Archiving is the only way to remove a part. Its data and full stock history are preserved, and the SKU stays reserved.</p>

        <%- include('../partials/flash') %>

        <% if (conflict) { %>
          <div class="flash flash--error" role="alert">
            <span class="flash__label">Blocked:</span>
            <p class="flash__message"><%= conflict %></p>
          </div>
        <% } %>

        <% if (!item.stock_quantity) { %>
          <form method="post" action="/items/<%= item.id %>/archive" novalidate>
            <%- include('../partials/csrf-input') %>
            <p class="confirm-text">Archive <strong>“<%= item.name %>”</strong>? It will stop accepting movements until restored.</p>
            <%- include('../partials/auth-field', { errors: {} }) %>
            <div class="form-actions">
              <button type="submit" class="button button--danger">Archive part</button>
              <a class="button button--ghost" href="/items/<%= item.id %>">Cancel</a>
            </div>
          </form>
        <% } else { %>
          <div class="notice">
            <p>Parts can only be archived with zero stock, and this one has <span class="mono"><%= item.stock_quantity %></span> unit<%= item.stock_quantity === 1 ? '' : 's' %>. Record a dispatch or an adjustment with a counted quantity of 0 first.</p>
          </div>
          <div class="form-actions">
            <a class="button button--primary" href="/items/<%= item.id %>/movements/new?type=dispatch">Record a dispatch</a>
            <a class="button button--ghost" href="/items/<%= item.id %>/movements/new?type=adjustment">Record an adjustment</a>
            <a class="button button--ghost" href="/items/<%= item.id %>">Cancel</a>
          </div>
        <% } %>
      </section>

      <aside class="form-layout__side">
        <%- include('../partials/item-context', { item }) %>
      </aside>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
