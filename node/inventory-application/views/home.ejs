<%- include('./partials/head', { title: 'Home' }) %>
<body>
  <%- include('./partials/header') %>
  <main id="main" class="container">
    <%- include('./partials/flash') %>

    <section class="page-head">
      <h1>Parts by category</h1>
      <p class="lede">Browse the catalog by category, or manage stock with the administrative password.</p>
    </section>

    <% if (!categories.length) { %>
      <%- include('./partials/empty-state', {
        title: 'No categories yet',
        text: 'Create the first category to start organizing the parts catalog.',
        actionHref: '/categories/new',
        actionLabel: 'Create a category'
      }) %>
    <% } else { %>
      <section aria-label="Categories">
        <ol class="index">
          <% categories.forEach((category, position) => { %>
            <li class="index__row">
              <span class="index__no mono" aria-hidden="true"><%= String(position + 1).padStart(2, '0') %></span>
              <h2 class="index__name"><a href="/categories/<%= category.id %>"><%= category.name %></a></h2>
              <p class="index__text"><%= category.description || '' %></p>
              <p class="index__count"><span class="mono"><%= category.active_item_count %></span> active part<%= category.active_item_count === 1 ? '' : 's' %></p>
            </li>
          <% }) %>
        </ol>
      </section>
    <% } %>
  </main>
  <%- include('./partials/footer') %>
</body>
</html>
