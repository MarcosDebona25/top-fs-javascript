<%- include('../partials/head') %>
<%
  const copy = {
    403: ['Not allowed', 'This action is not allowed.'],
    404: ['Page not found', "This page doesn't exist, or you don't have access to it."],
    410: ['Link expired', 'This share link has expired. Ask the owner to create a new one.'],
    500: ['Something went wrong', 'An unexpected error occurred. Try again in a moment.']
  };
  const [heading, fallback] = copy[status] || ['Error', 'Something went wrong.'];
%>
<section class="card state">
  <p class="state-code"><%= status %></p>
  <h1><%= heading %></h1>
  <p><%= message && status !== 404 && status !== 410 ? message : fallback %></p>
  <p><a class="button" href="/">Go to your drive</a></p>
</section>
<%- include('../partials/foot') %>
