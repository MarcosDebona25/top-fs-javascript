<%- include('../partials/head') %>
<div class="intro">
  <%- include('../partials/breadcrumbs', { items: breadcrumbs.map((crumb, index) => ({ name: crumb.name, href: index === breadcrumbs.length - 1 ? null : '/folders/' + crumb.id })) }) %>

  <div class="title-row">
    <h1><%= folder.name %></h1>
    <div class="actions">
      <% if (!isRoot) { %>
        <a class="button" href="/folders/<%= folder.id %>/rename" data-dialog-open="rename-dialog">Rename</a>
      <% } %>
      <a class="button" href="/folders/<%= folder.id %>/shares">Share links</a>
      <% if (!isRoot) { %>
        <a class="button button-danger" href="/folders/<%= folder.id %>/delete" data-dialog-open="delete-dialog">Delete folder</a>
      <% } %>
    </div>
  </div>
</div>

<section class="panel" aria-labelledby="contents-title">
  <div class="panel-head">
    <h2 id="contents-title" class="panel-title">Contents</h2>
    <div class="actions">
      <a class="button" href="/folders/<%= folder.id %>/new" data-dialog-open="create-dialog">New folder</a>
      <a class="button button-primary" href="/folders/<%= folder.id %>/upload" data-dialog-open="upload-dialog">Upload file</a>
    </div>
  </div>
  <% if (folders.length === 0 && files.length === 0) { %>
    <div class="empty">
      <p class="empty-title">This folder is empty</p>
      <p class="empty-text">Create a subfolder or upload a file to get started.</p>
    </div>
  <% } else { %>
    <%- include('../partials/listing', { folderBase: '/folders/', fileBase: '/files/' }) %>
  <% } %>
</section>

<p class="note">Files and folders can't be moved after creation. Files are stored at public, hard-to-guess URLs; private URLs are not supported yet.</p>

<% ['create', 'upload'].concat(isRoot ? [] : ['rename']).forEach((form) => { %>
  <dialog id="<%= form %>-dialog" class="modal" aria-labelledby="<%= form %>-title"<%= openForm === form ? ' open' : '' %>>
    <%- include('../partials/folder-form', { form, inDialog: true }) %>
  </dialog>
<% }) %>

<% if (!isRoot) { %>
  <dialog id="delete-dialog" class="modal" aria-labelledby="delete-title">
    <div class="modal-body">
      <h2 id="delete-title" class="modal-title">Delete "<%= folder.name %>"?</h2>
      <p class="modal-text"><%- include('../partials/delete-summary', deleteCounts) %></p>
      <div class="modal-actions">
        <button type="button" class="button" data-dialog-close>Cancel</button>
        <form method="post" action="/folders/<%= folder.id %>/delete">
          <button type="submit" class="button button-danger">Delete folder</button>
        </form>
      </div>
    </div>
  </dialog>
<% } %>
<%- include('../partials/foot') %>
