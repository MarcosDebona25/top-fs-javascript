# Database (role and database are created once with psql; see README)
DATABASE_URL="postgresql://blogapi:blogapi@localhost:5432/blog_api"

# Server
PORT=3000

# JWT: generate the secret with
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-64-random-bytes-in-hex"
JWT_EXPIRES_IN="60m"
JWT_ISSUER="blog-api"
JWT_AUDIENCE="blog-api-clients"

# Auth cookie: Secure is required; set to false only if a local client refuses Secure cookies over http://localhost
COOKIE_SECURE=true

# CORS: comma-separated list of origins allowed to call the API (reader, author)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Seed passwords (accounts author1..author5 and reader1..reader3)
AUTHOR_PASSWORD="change-me-author"
READER_PASSWORD="change-me-reader"
